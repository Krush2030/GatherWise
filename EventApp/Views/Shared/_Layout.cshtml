@using Microsoft.AspNetCore.Identity
@using GatherWise.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GatherWise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventApp.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f9fafb;
            color: #1f2937;
        }

        /* Modernized Header & Glass Navigation */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.8) !important;
            backdrop-filter: blur(16px) saturate(180%);
            -webkit-backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid rgba(243, 244, 246, 1) !important;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
            transition: all 0.3s ease;
        }

        /* Smooth Interactive Nav Underlines */
        .nav-link {
            position: relative;
            color: #4b5563 !important;
            transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 0.925rem;
        }

        .nav-link:hover {
            color: #198754 !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 4px;
            left: 1rem;
            background-color: #198754;
            transition: width 0.25s ease;
        }

        .nav-link:hover::after {
            width: calc(100% - 2rem);
        }

        /* Active Badges and Buttons styling */
        .profile-badge {
            background: #ffffff;
            border: 1px solid #e5e7eb !important;
            transition: all 0.2s ease;
        }

        .profile-badge:hover {
            border-color: #198754 !important;
            background: rgba(25, 135, 84, 0.02);
        }

        .btn-logout {
            transition: color 0.2s ease;
        }
        
        .btn-logout:hover {
            color: #dc3545 !important;
        }

        /* Modern Minimal Footer */
        .footer-custom {
            background-color: #ffffff;
            border-top: 1px solid #f3f4f6;
        }

        .hover-link-success {
            transition: color 0.2s ease;
        }
        .hover-link-success:hover {
            color: #198754 !important;
        }

        /* Page entry micro-animation */
        .animate-fade-in {
            animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom sticky-top py-3">
            <div class="container">
                <!-- Premium Brand Identity Logomark -->
                <a class="navbar-brand fw-bold text-success d-flex align-items-center gap-2 fs-4 tracking-tight" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="bg-success bg-opacity-10 p-2 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-seam-fill text-success fs-4"></i>
                    </div>
                    <span>GatherWise</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent" aria-controls="navbarMainContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse" id="navbarMainContent">
                    <!-- Central Contextual Pipelines Link Matrix -->
                    <ul class="navbar-nav mx-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-semibold px-3 py-2" asp-area="" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Admin Dashboard
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-semibold px-3 py-2" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Venue" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Venues
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-journal-bookmark-fill me-1"></i> Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Payment" asp-action="Index">
                                <i class="bi bi-receipt-cutoff me-1"></i> Payments
                            </a>
                        </li>

                        <!-- DEDICATED VENUE OWNER/ADMIN ACCESSIBLE PIPELINE -->
                        @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Venue Owner") || User.IsInRole("Admin")))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-success px-3 py-2" asp-area="" asp-controller="Slot" asp-action="Index">
                                    <i class="bi bi-calendar3 me-1"></i> Manage Slots
                                </a>
                            </li>
                        }

                        <!-- SECURED ROLE FILTER: Only Visible explicitly to verified Vendor Identities -->
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Vendor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="VendorAssignment" asp-action="CustomerOverview">
                                    <i class="bi bi-people me-1"></i> Our Team
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Vendor" asp-action="MyServices">
                                    <i class="bi bi-grid-3x3-gap me-1"></i> My Services
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium px-3 py-2" asp-area="" asp-controller="Vendor" asp-action="AddService">
                                    <i class="bi bi-patch-plus me-1"></i> Add Service
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Authentication Call-To-Action Framework Elements -->
                    <ul class="navbar-nav align-items-center gap-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            
                            <li class="nav-item">
                                <a asp-controller="Profile" asp-action="Index" class="text-decoration-none">
                                    <span class="badge profile-badge text-dark p-2 d-flex align-items-center gap-2 rounded-pill shadow-sm px-3">
                                        <i class="bi bi-person-circle text-success fs-6"></i>
                                        <span class="fw-semibold text-secondary">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                    </span>
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <form class="form-inline m-0" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link text-secondary text-decoration-none btn-logout p-0 fw-medium d-flex align-items-center gap-1">
                                        <i class="bi bi-box-arrow-right text-danger"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-link text-success text-decoration-none fw-semibold px-3" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success rounded-pill px-4 shadow-sm fw-medium d-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
                                    Get Started <i class="bi bi-arrow-right small"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Dynamic Slot Render Container -->
    <div class="container my-5 flex-shrink-0">
        <main role="main" class="pb-5 animate-fade-in">
            @RenderBody()
        </main>
    </div>

    <!-- Clean, High-Contrast Minimalist Footer -->
    <footer class="footer mt-auto py-4 footer-custom">
        <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span class="text-muted small">&copy; 2026 <span class="text-success fw-semibold">GatherWise</span>. All rights reserved.</span>
            <div class="d-flex align-items-center gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted small text-decoration-none hover-link-success">Privacy Policy</a>
                <span class="text-muted opacity-25 small">|</span>
                <span class="text-muted small d-flex align-items-center gap-1"><i class="bi bi-shield-lock-fill text-success opacity-75"></i> Smart Operational Platform</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>