@using Microsoft.AspNetCore.Identity
@using GatherWise.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GatherWise</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventApp.styles.css" asp-append-version="true" />

    <style>
            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f8f9fa;
            }
            /* Sticky footer adjustments */
            body, html {
                height: 100%;
            }

            .wrapper {
                min-height: 100%;
                margin-bottom: -60px; /* Equal to footer height */
                padding-bottom: 60px;
            }

            .footer {
                height: 60px;
            }
            /* Modernized active link state transitions */
            .nav-link {
                position: relative;
                transition: color 0.25s ease;
            }

                .nav-link:hover {
                    color: #198754 !important;
                }
            /* Glassmorphism shadow container styling */
            .navbar-custom {
                background-color: rgba(255, 255, 255, 0.95) !important;
                backdrop-filter: blur(10px);
                box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04);
            }
    </style>
</head>
<body class="d-flex flex-column h-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom sticky-top border-bottom border-light py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-success d-flex align-items-center gap-2 fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-seam-fill text-success fs-3"></i> GatherWise
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMainContent" aria-controls="navbarMainContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse" id="navbarMainContent">
                    <ul class="navbar-nav mx-auto gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-semibold px-3" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Venue" asp-action="Index">
                                <i class="bi bi-building me-1"></i> Venues
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Slot" asp-action="Index">
                                <i class="bi bi-calendar3 me-1"></i> Slots
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Booking" asp-action="Index">
                                <i class="bi bi-journal-bookmark-fill me-1"></i> Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Payment" asp-action="Index">
                                <i class="bi bi-receipt-cutoff me-1"></i> Payments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="VendorAssignment" asp-action="CustomerOverview">
                                <i class="bi bi-people me-1"></i> Our Team
                            </a>
                        </li>

                        @* @if (User.IsInRole("Admin"))
                        {
                            <div>
                                <a asp-controller="VendorAssignment" asp-action="Create" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-plus-circle-fill"></i> Assign New Vendor
                                </a>
                            </div>
                        } *@
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-semibold px-3" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>
    
                            @if (User.IsInRole("Vendor"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Vendor" asp-action="MyServices">
                                        <i class="bi bi-grid-3x3-gap me-1"></i> My Services
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-secondary fw-medium px-3" asp-area="" asp-controller="Vendor" asp-action="AddService">
                                        <i class="bi bi-patch-plus me-1"></i> Add New Service
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center gap-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            <li class="nav-item">
                                <span class="badge bg-light text-dark border p-2 d-flex align-items-center gap-2 rounded-pill shadow-sm px-3">
                                    <i class="bi bi-person-circle text-success fs-6"></i>
                                    <span class="fw-semibold">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline m-0" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link text-secondary text-decoration-none hover-text-danger p-0 fw-medium">
                                        <i class="bi bi-box-arrow-right me-1 text-danger"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-link text-success text-decoration-none fw-semibold px-3" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-success rounded-pill px-4 shadow-sm fw-medium d-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
                                    Get Started <i class="bi bi-arrow-right small"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5 flex-shrink-0">
        <main role="main" class="pb-5 animate-fade-in">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white border-top">
        <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span class="text-muted small">&copy; 2026 <span class="text-success fw-semibold">GatherWise</span>. All rights reserved.</span>
            <div class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted small text-decoration-none hover-text-success">Privacy Policy</a>
                <span class="text-muted small">|</span>
                <span class="text-muted small">Smart Operational Platform</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>