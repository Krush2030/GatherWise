@model GatherWise.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <!-- Premium Branded Header -->
                <div class="bg-success bg-opacity-10 text-success p-4 text-center border-bottom border-light">
                    <div class="p-3 bg-success text-white rounded-circle d-inline-block mb-2 shadow-sm">
                        <i class="bi bi-person-plus-fill fs-4 d-flex"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Join GatherWise</h3>
                    <p class="text-muted small mb-0">Select your specific ecosystem profile role to get started</p>
                </div>
                
                <!-- Registration Form Body -->
                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>

                        <!-- Full Name Input -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-dark small">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="John Doe" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Email Address Input -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Account Role Selector Dropdown -->
                        <div class="mb-3">
                            <label asp-for="SelectedRole" class="form-label fw-semibold text-dark small">Account Profile Role</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                <select asp-for="SelectedRole" class="form-select border-start-0 ps-0" asp-items="@(new SelectList(ViewBag.Roles))">
                                    <option value="">-- Choose Account Role Type --</option>
                                </select>
                            </div>
                            <span asp-validation-for="SelectedRole" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Split Password Configurations Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label asp-for="Password" class="form-label fw-semibold text-dark small">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small">Confirm Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key-fill"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>

                        <!-- Submit and Flip Links -->
                        <button type="submit" class="btn btn-success w-100 rounded-pill py-2.5 fw-semibold shadow-sm mb-3">
                            Create Account <i class="bi bi-arrow-right small ms-1"></i>
                        </button>
                        
                        <div class="text-center pt-2 border-top border-light">
                            <span class="text-muted small">Already registered?</span>
                            <a asp-action="Login" class="text-success text-decoration-none fw-semibold small ms-1">Login Here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}