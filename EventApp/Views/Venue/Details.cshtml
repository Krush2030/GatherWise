@model GatherWise.Domain.Entities.Venue
@using System.Security.Claims

@{
    ViewData["Title"] = "Venue Details";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwnVenue = Model.OwnerId == currentUserId;
}

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        
        <div class="bg-dark text-white p-4 position-relative">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                        <h2 class="mb-0 fw-bold text-white">@Model.Name</h2>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-light text-dark rounded-pill border small">Admin Core Entry</span>
                        }
                        @if (isOwnVenue)
                        {
                            <span class="badge bg-success rounded-pill small">Your Listing</span>
                        }
                    </div>
                    <p class="mb-0 opacity-75"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location</p>
                </div>
                <div>
                    <span class="badge @(Model.IsAvailable ? "bg-success bg-opacity-20 text-success border border-success border-opacity-20" : "bg-danger bg-opacity-20 text-danger border border-danger border-opacity-20") fs-6 px-4 py-2 rounded-pill">
                        <i class="bi bi-circle-fill me-1 small"></i> @(Model.IsAvailable ? "Active Catalog" : "Deactivated")
                    </span>
                </div>
            </div>
        </div>

        @if (Model.Images != null && Model.Images.Any())
        {
            <div id="venueCarousel" class="carousel slide bg-light border-bottom" data-bs-ride="carousel" style="max-height: 450px; overflow: hidden;">
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <button type="button" data-bs-target="#venueCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "")"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @{
                        int index = 0;
                    }
                    @foreach (var img in Model.Images)
                    {
                        <div class="carousel-item @(index == 0 ? "active" : "")" style="height: 450px;">
                            <img src="@img.ImagePath" class="d-block w-100 h-100 object-fit-cover" alt="Venue image asset">
                        </div>
                        index++;
                    }
                </div>
                @if (Model.Images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#venueCarousel" data-bs-slide-prev>
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#venueCarousel" data-bs-slide-next>
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                }
            </div>
        }

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-5 border-md-end pe-md-4">
                    <h5 class="text-success text-uppercase small fw-bold tracking-wider mb-3">Operational Framework</h5>
                    
                    <div class="p-3 bg-light rounded-3 mb-3 d-flex align-items-center justify-content-between">
                        <div>
                            <label class="text-muted small d-block text-uppercase">Max Allowed Capacity</label>
                            <span class="fs-5 fw-bold text-dark">@Model.Capacity Guests</span>
                        </div>
                        <i class="bi bi-people text-secondary fs-3 opacity-50"></i>
                    </div>

                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 mb-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <label class="text-success-emphasis small d-block text-uppercase">Price / Scheduled Window</label>
                                <span class="fs-5 fw-bold">₹@Model.PricePerSlot.ToString("N2")</span>
                            </div>
                            <i class="bi bi-cash-stack fs-3 opacity-50"></i>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin") || isOwnVenue)
                    {
                        <div class="card border-primary border-opacity-20 shadow-sm rounded-3 bg-white mt-4">
                            <div class="card-header bg-primary bg-opacity-10 border-0 py-3 d-flex justify-content-between align-items-center">
                                <h6 class="fw-bold text-primary mb-0"><i class="bi bi-gear-fill me-2"></i>Manage Operating Slots</h6>
                                <a asp-controller="Slot" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                    <i class="bi bi-plus-lg"></i> Add Slots
                                </a>
                            </div>
                            <div class="card-body p-3">
                                <div id="ownerSlotsLoader" class="text-center py-2">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                </div>
                                <div id="ownerSlotsContainer" class="d-none" style="max-height: 200px; overflow-y: auto;">
                                    <ul id="ownerSlotsList" class="list-group list-group-flush small"></ul>
                                </div>
                                <div id="ownerNoSlotsMessage" class="text-center py-2 d-none">
                                    <p class="text-muted small mb-0">No time slot listings configured yet.</p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (User.IsInRole("Event Host") && !isOwnVenue && Model.IsAvailable)
                    {
                        <div class="card border-success border-opacity-20 shadow-sm rounded-3 bg-white mt-4">
                            <div class="card-header bg-success bg-opacity-10 border-0 py-3">
                                <h6 class="fw-bold text-success mb-0"><i class="bi bi-calendar-check-fill me-2"></i>Select Operating Window</h6>
                            </div>
                            <div class="card-body p-3">
                                <div id="slotsLoader" class="text-center py-3">
                                    <div class="spinner-border text-success spinner-border-sm" role="status"></div>
                                    <small class="text-muted d-block mt-2">Checking active schedule tables...</small>
                                </div>
                                <div id="slotsContainer" class="d-none">
                                    <div class="mb-3">
                                        <label class="form-label small text-muted font-monospace">Available Operating Windows</label>
                                        <select id="slotSelectorEngine" class="form-select rounded-3 small text-dark border-light-subtle"></select>
                                    </div>
                                    <button type="button" id="btnInitiateBooking" class="btn btn-success w-100 rounded-pill fw-bold btn-sm py-2" disabled>
                                        <i class="bi bi-calendar-plus me-1"></i> Lock Slot & Proceed
                                    </button>
                                </div>
                                <div id="noSlotsMessage" class="text-center py-3 d-none">
                                    <i class="bi bi-calendar-x text-muted fs-4"></i>
                                    <p class="text-muted small mb-0 mt-1">No vacant functional slots exist currently.</p>
                                </div>
                            </div>
                        </div>

                        <!-- REPORT VENUE OWNER INTERACTION CARD ENTRY -->
                        <div class="card border-danger border-opacity-20 shadow-sm rounded-3 bg-white mt-3">
                            <div class="card-body p-3 text-center">
                                <p class="small text-muted mb-2">Encountering structural or operational problems with this vendor profile?</p>
                                <a asp-controller="Report" asp-action="Create" asp-route-reportedUserId="@Model.OwnerId" class="btn btn-sm btn-outline-danger rounded-pill px-4">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Report Venue Owner
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-md-7 ps-md-4">
                    <h5 class="text-dark text-uppercase small fw-bold tracking-wider mb-3">Listing Profile & Amenities</h5>
                    <div class="bg-light p-4 rounded-3 mb-4">
                        <p class="text-secondary mb-0 fs-6" style="white-space: pre-line; line-height: 1.6;">
                            @(string.IsNullOrEmpty(Model.Description) ? "No supplemental description context provided for this operational line record item." : Model.Description)
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between mt-5 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill align-self-start">
                    <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                </a>
                
                <div class="d-flex gap-2 w-100 w-sm-auto justify-content-end">
                    @if (User.IsInRole("Admin") || isOwnVenue)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4 rounded-pill shadow-sm text-dark fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i> Edit Record
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4 rounded-pill">
                            <i class="bi bi-trash me-1"></i> Delete
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const venueId = "@Model.Id";
            
            // Elements for Event Hosts booking flow
            const slotsLoader = document.getElementById("slotsLoader");
            const slotsContainer = document.getElementById("slotsContainer");
            const noSlotsMessage = document.getElementById("noSlotsMessage");
            const selector = document.getElementById("slotSelectorEngine");
            const btnBooking = document.getElementById("btnInitiateBooking");

            // Elements for Owners/Admins management view dashboard panel
            const ownerSlotsLoader = document.getElementById("ownerSlotsLoader");
            const ownerSlotsContainer = document.getElementById("ownerSlotsContainer");
            const ownerNoSlotsMessage = document.getElementById("ownerNoSlotsMessage");
            const ownerSlotsList = document.getElementById("ownerSlotsList");

            // 1. ASYNCHRONOUSLY FETCH SLOTS GRID FROM API LOGIC
            fetch(`/Booking/GetAvailableSlots?venueId=${venueId}`)
                .then(res => res.json())
                .then(data => {
                    // Populate Owner's internal panel if present
                    if (ownerSlotsLoader) {
                        ownerSlotsLoader.classList.add("d-none");
                        if (data.length === 0) {
                            ownerNoSlotsMessage.classList.remove("d-none");
                        } else {
                            ownerSlotsList.innerHTML = "";
                            data.forEach(s => {
                                const statusBadge = s.isBooked
                                    ? `<span class="badge bg-danger rounded-pill">Booked</span>`
                                    : `<span class="badge bg-success rounded-pill">Available</span>`;
                                
                                ownerSlotsList.innerHTML += `
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 border-light-subtle">
                                        <div>
                                            <span class="fw-semibold d-block">${s.date}</span>
                                            <span class="text-muted text-xs">${s.startTime} - ${s.endTime}</span>
                                        </div>
                                        ${statusBadge}
                                    </li>`;
                            });
                            ownerSlotsContainer.classList.remove("d-none");
                        }
                    }

                    // Populate Host's Booking panel if present
                    if (slotsLoader) {
                        slotsLoader.classList.add("d-none");
                        const freeSlots = data.filter(s => !s.isBooked);

                        if (freeSlots.length === 0) {
                            noSlotsMessage.classList.remove("d-none");
                            return;
                        }

                        selector.innerHTML = `<option value="" disabled selected>-- Choose an open date/time window --</option>`;
                        freeSlots.forEach(s => {
                            selector.innerHTML += `<option value="${s.id}">${s.date} [${s.startTime} - ${s.endTime}]</option>`;
                        });

                        slotsContainer.classList.remove("d-none");
                    }
                })
                .catch(err => {
                    console.error("Error evaluating schedule tables:", err);
                    if(slotsLoader) slotsLoader.innerHTML = "<small class='text-danger'>Failed to initialize slot metrics.</small>";
                    if(ownerSlotsLoader) ownerSlotsLoader.innerHTML = "<small class='text-danger'>Failed to load configurations.</small>";
                });

            // 2. FORM ACTION TRIGGER CONTROLS FOR BOOKING BUTTON
            if (selector) {
                selector.addEventListener("change", function () {
                    btnBooking.disabled = !this.value;
                });
            }

            if (btnBooking) {
                btnBooking.addEventListener("click", function () {
                    const selectedSlotId = selector.value;
                    if (selectedSlotId) {
                        window.location.href = `/Booking/Create?venueId=${venueId}&slotId=${selectedSlotId}`;
                    }
                });
            }
        });
    </script>
}