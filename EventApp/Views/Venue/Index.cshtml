@model IEnumerable<GatherWise.Domain.Entities.Venue>
@using System.Security.Claims

@{
    ViewData["Title"] = "Explore Venues";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<style>
    /* Premium Architecture Glassmorphism & Micro-animations */
    .venue-card {
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.06) !important;
        background: #ffffff;
    }
    
        .venue-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1.25rem 2.5rem rgba(0, 0, 0, 0.075) !important;
        }

    .image-zoom-container {
        overflow: hidden;
        height: 220px;
        position: relative;
        background-color: #f8f9fa;
    }

        .image-zoom-container img {
            transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

    .venue-card:hover .image-zoom-container img {
        transform: scale(1.06);
    }

    .gradient-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
        background: linear-gradient(to top, rgba(0,0,0,0.35), transparent);
        z-index: 1;
    }

    .glass-badge {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(4px);
        color: #212529;
        font-weight: 600;
        border: 1px solid rgba(0, 0, 0, 0.08);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .custom-line-clamp {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 42px;
    }
</style>

<div class="container py-5">
    <!-- Premium Header Area -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5 pb-4 border-bottom">
        <div>
            <span class="text-success text-uppercase tracking-wider fw-bold small mb-1 d-block">Curated Spaces</span>
            <h1 class="fw-black text-dark mb-1 d-flex align-items-center">
                <i class="bi bi-compass text-success me-3"></i>Discover Spectacular Venues
            </h1>
            <p class="text-muted mb-0">Find and reserve the perfect backdrop configuration for your next milestone event.</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Venue Owner"))
        {
            <div class="flex-shrink-0">
                <a class="btn btn-success rounded-3 p-3 px-4 shadow-sm fw-medium d-inline-flex align-items-center gap-2" asp-action="Create">
                    <i class="bi bi-plus-lg fs-6"></i> List a New Venue
                </a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <!-- Empty State UI -->
        <div class="card shadow-sm border-0 rounded-4 text-center p-5 bg-light border-dashed">
            <div class="card-body py-5">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <i class="bi bi-building-exclamation fs-2 text-muted"></i>
                </div>
                <h4 class="fw-bold text-dark">No Venues Available Yet</h4>
                <p class="text-muted mx-auto mb-4" style="max-width: 420px;">
                    Our premium ecosystem catalog is currently dry. Check back shortly or add your own structural listing to open allocations.
                </p>
                @if (User.IsInRole("Admin") || User.IsInRole("Venue Owner"))
                {
                    <a class="btn btn-outline-dark rounded-3 px-4 fw-medium btn-sm" asp-action="Create">Add Property Listing</a>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Venue Catalog Cards Grid -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var venue in Model)
            {
                var isOwnVenue = venue.OwnerId == currentUserId;

                <div class="col">
                    <div class="card h-100 shadow-sm rounded-4 border-0 position-relative overflow-hidden venue-card">
                        
                        <!-- Floated Badges Matrix -->
                        <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2" style="z-index: 2;">
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge glass-badge rounded-pill px-3 py-2 small d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-shield-lock-fill text-dark"></i> Admin View
                                </span>
                            }
                            @if (isOwnVenue)
                            {
                                <span class="badge bg-success text-white rounded-pill px-3 py-2 small fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                                    <i class="bi bi-person-check-fill"></i> Your Property
                                </span>
                            }
                        </div>

                        <!-- Image Presentation Layer -->
                        <div class="image-zoom-container border-bottom">
                            <div class="gradient-overlay"></div>
                            @if (venue.Images != null && venue.Images.Any())
                            {
                                <img src="@venue.Images.First().ImagePath" class="w-100 h-100 object-fit-cover" alt="@venue.Name thumbnail cover" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 bg-success bg-opacity-5 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-building-fill text-success opacity-25" style="font-size: 4rem;"></i>
                                </div>
                            }
                        </div>

                        <!-- Details Body Context -->
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="mb-2">
                                <h5 class="fw-bold text-dark text-truncate mb-1" title="@venue.Name">@venue.Name</h5>
                                <span class="text-muted small d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-geo-alt-fill text-danger opacity-75 small"></i> @venue.Location
                                </span>
                            </div>
                            
                            <p class="text-secondary small mb-4 flex-grow-1 custom-line-clamp">
                                @(string.IsNullOrEmpty(venue.Description) ? "No deep architectural context or descriptions mapped to this system asset item profile." : venue.Description)
                            </p>
                            
                            <!-- Actions/Price Block Line -->
                            <div class="d-flex align-items-center justify-content-between mt-auto pt-3 border-top border-light">
                                <div>
                                    <span class="text-muted d-block" style="font-size: 0.7rem; uppercase; font-weight: 700; letter-spacing: 0.5px;">FLAT RATE PER SLOT</span>
                                    <h5 class="text-success fw-black mb-0 font-monospace">₹@venue.PricePerSlot.ToString("N2")</h5>
                                </div>
                                <a asp-action="Details" asp-route-id="@venue.Id" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold btn-sm d-inline-flex align-items-center gap-1">
                                    View Space <i class="bi bi-arrow-right fs-7"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>