@{
    ViewData["Title"] = "File Formal System Report";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-danger text-white py-3 rounded-top-4">
            <h5 class="mb-0 fw-bold"><i class="bi bi-shield-exclamation me-2"></i>Report User Infraction</h5>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning small rounded-3" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> This action files a structured complaint directly to application security operations.
            </div>

            <div class="mb-4 bg-light p-3 rounded-3 border">
                <h6 class="text-uppercase small text-muted fw-bold tracking-wider mb-2">Target Profile Metrics</h6>
                <div class="row g-2 small">
                    <div class="col-4 text-secondary">Username / Name:</div>
                    <div class="col-8 text-dark fw-bold">@ViewBag.TargetUserName</div>
                    <div class="col-4 text-secondary">System Account ID:</div>
                    <div class="col-8 text-monospace text-muted">@ViewBag.TargetUserId</div>
                    <div class="col-4 text-secondary">Contact Number:</div>
                    <div class="col-8 text-dark">@ViewBag.TargetPhone</div>
                </div>
            </div>

            <form asp-controller="Report" asp-action="Create" method="post">
                <input type="hidden" name="reportedUserId" value="@ViewBag.TargetUserId" />
                
                <div class="mb-4">
                    <label for="description" class="form-label fw-bold text-dark">Infraction Incident Description</label>
                    <textarea class="form-control rounded-3" id="description" name="description" rows="5" required
                              placeholder="Describe cleanly what occurred, including structural, financial, or timing violations..."></textarea>
                    <div class="form-text small">Please be clear and descriptive to allow accurate administration tracking review.</div>
                </div>

                <div class="d-flex gap-2 justify-content-end border-top pt-3">
                    <a href="javascript:history.back()" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-send me-1"></i> Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>