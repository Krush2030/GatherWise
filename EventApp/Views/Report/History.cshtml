@model List<GatherWise.Domain.Entities.UserReport>
@{
    ViewData["Title"] = "My Infraction Reporting Ledger";
    var userNames = ViewBag.UserMap as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="container my-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="text-dark fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i>My Reported Incidents History</h2>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-person me-1"></i> Return to Profile Dashboard
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card border-0 bg-light p-5 text-center shadow-sm rounded-4">
            <i class="bi bi-shield-check display-3 text-success mb-3 opacity-70"></i>
            <h5 class="fw-bold text-dark">Clean Reporting Ledger</h5>
            <p class="text-muted mb-0">You have not logged any system policy infraction reports against application users.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var report in Model)
            {
                var reportedName = userNames.ContainsKey(report.ReportedUserId) ? userNames[report.ReportedUserId] : "Unknown Client Account";
                
                <div class="col-12">
                    <div class="card shadow-sm border border-light rounded-3 overflow-hidden">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="small text-muted">Reported User:</span>
                                <strong class="text-danger ms-1">@reportedName</strong>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <small class="text-muted font-monospace"><i class="bi bi-calendar3 me-1"></i>@report.CreatedAt.ToLocalTime().ToString("g")</small>
                                @if (report.IsResolved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-20 px-3 py-1 rounded-pill">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning border-opacity-20 px-3 py-1 rounded-pill">Pending Audit</span>
                                }
                            </div>
                        </div>
                        <div class="card-body bg-light bg-opacity-40">
                            <h6 class="small text-muted text-uppercase fw-bold tracking-wider mb-2">Incident Log Description</h6>
                            <p class="text-dark mb-0 small text-secondary" style="white-space: pre-line;">@report.Description</p>
                            
                            @if (report.IsResolved)
                            {
                                <div class="mt-3 p-3 bg-white border border-success border-opacity-30 rounded-3">
                                    <h6 class="small text-success text-uppercase fw-bold tracking-wider mb-1">
                                        <i class="bi bi-reply-all-fill me-1"></i> Administrative Operational Feedback Box
                                    </h6>
                                    <p class="text-success-emphasis mb-0 small">@report.AdminReply</p>
                                    @if (report.ResolvedAt.HasValue)
                                    {
                                        <small class="text-muted d-block mt-2 font-monospace text-xs text-end">Handled: @report.ResolvedAt.Value.ToLocalTime().ToString("g")</small>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>