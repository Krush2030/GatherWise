@model GatherWise.Domain.Entities.Vendor

@{
    ViewData["Title"] = "Add My Service";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="bg-success bg-opacity-10 text-success p-4 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-success text-white rounded-3 fs-4 d-inline-flex">
                            <i class="bi bi-patch-plus"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold text-dark">Add My Vendor Service</h4>
                            <p class="text-muted mb-0 small">Publish your commercial business capabilities to the platform event booking pool.</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark small">Company / Business Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-briefcase"></i></span>
                                <input asp-for="BusinessName" class="form-control border-start-0 ps-0" placeholder="e.g. Skyline Catering Services" />
                            </div>
                            <span asp-validation-for="BusinessName" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark small">Service Specialization Category</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tags"></i></span>
                                <select asp-for="ServiceCategory" class="form-select border-start-0 ps-0">
                                    <option value="">-- Choose what service you offer --</option>
                                    <option value="Caterers (Food & Beverages)">Caterers (Food & Beverages)</option>
                                    <option value="Decorators & Florists (Theme & Setup)">Decorators & Florists (Theme & Setup)</option>
                                    <option value="Photographers & Videographers (Media capture)">Photographers & Videographers (Media capture)</option>
                                    <option value="DJs / Sound Systems (Entertainment)">DJs / Sound Systems (Entertainment)</option>
                                </select>
                            </div>
                            <span asp-validation-for="ServiceCategory" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark small">Point of Contact Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="ContactName" class="form-control border-start-0 ps-0" placeholder="Full Name" />
                                </div>
                                <span asp-validation-for="ContactName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold text-dark small">Business Telephone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="Phone number" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark small">Official Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="hello@yourbusiness.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark small">Base Operational Booking Price ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="BasePrice" type="number" step="0.01" class="form-control border-start-0 ps-0" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-end pt-3 border-top border-light">
                            <a class="btn btn-outline-secondary px-4 rounded-pill" href="javascript:history.back()">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm fw-semibold">Publish Service</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}