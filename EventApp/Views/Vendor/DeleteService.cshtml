@model GatherWise.Domain.Entities.VendorService
@{
    ViewData["Title"] = "De-list Service Profile Asset";
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="MyServices" class="btn btn-link text-decoration-none text-muted p-0 d-inline-flex align-items-center gap-2 small fw-semibold">
            <i class="bi bi-arrow-left"></i> Abort & Return to Services
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <!-- Warning Prompt Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white mb-4">
                <div class="bg-danger text-white p-4 d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-20 rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-exclamation-triangle-fill fs-4 text-white"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-white">Confirm Permanent Deletion</h4>
                        <p class="mb-0 text-white-50 small">This action will flush database matrices and wipe physical image uploads.</p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <h5 class="text-uppercase small tracking-wider text-muted fw-bold mb-4">Target Listing Summary</h5>
                    
                    <div class="d-flex flex-column flex-sm-row gap-4 align-items-start align-items-sm-center pb-4 border-bottom mb-4">
                        <div class="rounded-4 overflow-hidden bg-light border" style="width: 100px; height: 100px; min-width: 100px;">
                            @if (!string.IsNullOrEmpty(Model.MainPhotoPath))
                            {
                                <img src="@Model.MainPhotoPath" class="w-100 h-100 object-fit-cover" alt="Main cover asset thumbnail" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted bg-secondary bg-opacity-10">
                                    <i class="bi bi-image fs-3"></i>
                                </div>
                            }
                        </div>
                        <div>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-20 rounded-pill px-3 py-1 mb-2 small fw-semibold">
                                @Model.ServiceCategory
                            </span>
                            <h4 class="fw-bold text-dark mb-1">@Model.ServiceName</h4>
                            <p class="text-muted small font-monospace mb-0"><i class="bi bi-telephone me-1"></i>Contact Line: @Model.ServicePhone</p>
                        </div>
                    </div>

                    <div class="row g-3 mb-5">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-4 border border-light-subtle">
                                <span class="text-muted d-block small mb-1" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">BASE PRICE STRUCTURE</span>
                                <span class="fw-bold text-dark fs-5 font-monospace">₹@Model.BasePrice.ToString("N2")</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded-4 border border-light-subtle">
                                <span class="text-muted d-block small mb-1" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">PERSON CAP VALUE</span>
                                <span class="fw-bold text-dark fs-5">@Model.PerNumberOfPersons Headcount</span>
                            </div>
                        </div>
                    </div>

                    <!-- Secure Submission Mechanism -->
                    <form asp-action="DeleteService" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-end align-items-stretch">
                            <a asp-action="MyServices" class="btn btn-outline-secondary rounded-3 p-3 px-4 fw-medium text-center">
                                Cancel, Keep Listing
                            </a>
                            <button type="submit" class="btn btn-danger rounded-3 p-3 px-4 fw-bold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                                <i class="bi bi-trash3-fill"></i> Permanently Delete Service
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>