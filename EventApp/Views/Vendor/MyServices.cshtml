@model IEnumerable<GatherWise.Domain.Entities.VendorService>

@{
    ViewData["Title"] = "My Services Dashboard";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light">
        <div>
            <h3 class="fw-bold text-dark mb-1">My Managed Offerings</h3>
            <p class="text-muted mb-0 small">Review and manage your commercial service listings.</p>
        </div>
        <a asp-action="AddService" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill"></i> Add New Service
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 my-4 bg-white rounded-4 shadow-sm border border-light">
            <div class="display-1 text-muted opacity-25 mb-3">
                <i class="bi bi-archive"></i>
            </div>
            <h5 class="fw-bold text-secondary">No Services Listed Yet</h5>
            <p class="text-muted small mb-4">You haven't added any operational capabilities to your vendor account profile registry yet.</p>
            <a asp-action="AddService" class="btn btn-outline-success rounded-pill px-4 btn-sm fw-semibold">Publish First Service</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="position-relative bg-light" style="height: 180px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(item.MainPhotoPath))
                            {
                                <img src="@item.MainPhotoPath" class="w-100 h-100" style="object-fit: cover;" alt="Service Image" />
                            }
                            else
                            {
                                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            <span class="position-absolute top-3 start-3 badge bg-dark bg-opacity-75 py-2 px-3 rounded-pill text-white small">
                                @item.ServiceCategory
                            </span>
                        </div>

                        <!-- Updated dynamic body with the detail presentation layout -->
                        <div class="card-body p-4 d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-2 text-truncate">@item.ServiceName</h5>
                            
                            <div class="mb-3 text-muted small">
                                <i class="bi bi-telephone text-success me-1"></i> @item.ServicePhone
                            </div>

                            <div class="bg-light rounded-3 p-3 border border-light-subtle mb-3">
                                <span class="text-secondary small d-block mb-1">Price Structure</span>
                                <div class="d-flex align-items-baseline gap-1 text-success">
                                    <h4 class="fw-bold mb-0">₹@item.BasePrice.ToString("N2")</h4>
                                    <span class="text-muted small">/ @item.PerNumberOfPersons persons</span>
                                </div>
                            </div>

                            <!-- Details Anchor Link Registry -->
                            <div class="mt-auto pt-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success w-100 rounded-pill btn-sm fw-semibold">
                                    <i class="bi bi-eye me-1"></i> View Full Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>