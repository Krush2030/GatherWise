@model IEnumerable<GatherWise.Domain.Entities.AdminOwnerChatMessage>
@using System.Security.Claims

@{
    ViewData["Title"] = "Report Mediation Chat Room";
    var ticket = ViewBag.CurrentReport as GatherWise.Domain.Entities.UserReport;
    var userDict = ViewBag.SystemUsers as Dictionary<string, string> ?? new Dictionary<string, string>();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-4">
    <!-- Breadcrumb Routing Links -->
    <div class="mb-3">
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Console Dashboard
            </a>
        }
        else
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Member Dashboard
            </a>
        }
    </div>

    <div class="row g-4">
        <!-- Ticket Meta Panel Details Sidecard -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 position-sticky" style="top: 100px;">
                <div class="card-header bg-dark text-white p-4 rounded-top-4">
                    <span class="badge bg-danger mb-2">Ticket Resolution Context</span>
                    <h5 class="fw-bold m-0 text-truncate">Incident Verification Summary</h5>
                </div>
                <div class="card-body p-4 bg-white rounded-bottom-4">
                    <div class="mb-3">
                        <label class="text-uppercase tracking-wider small text-muted fw-bold d-block mb-1">Incident File Details</label>
                        <p class="small text-secondary font-monospace mb-0">Filed on: @ticket?.CreatedAt.ToLocalTime().ToString("g")</p>
                    </div>

                    <div class="mb-3 border-top pt-3">
                        <label class="text-uppercase tracking-wider small text-muted fw-bold d-block mb-1">Associated Parties</label>
                        <div class="d-flex flex-column gap-1">
                            <span class="small"><i class="bi bi-person-fill text-primary me-1"></i> Reporter: <strong>@(userDict.ContainsKey(ticket?.ReporterId ?? "") ? userDict[ticket.ReporterId] : "Unknown")</strong></span>
                            <span class="small"><i class="bi bi-person-exclamation text-danger me-1"></i> Accused Subject: <strong>@(userDict.ContainsKey(ticket?.ReportedUserId ?? "") ? userDict[ticket.ReportedUserId] : "Unknown")</strong></span>
                        </div>
                    </div>

                    <div class="border-top pt-3">
                        <label class="text-uppercase tracking-wider small text-muted fw-bold d-block mb-2">Original Violation Log Description</label>
                        <div class="p-3 bg-light rounded-3 text-secondary border border-light small" style="white-space: pre-line; max-height: 200px; overflow-y: auto;">
                            @ticket?.Description
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chat Feed Room Window Pipeline -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 d-flex flex-column" style="height: 700px;">
                
                <!-- Room Header Status Grid -->
                <div class="card-header bg-white border-bottom p-4 d-flex align-items-center justify-content-between rounded-top-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success bg-opacity-10 p-2.5 rounded-3 text-success">
                            <i class="bi bi-chat-left-dots-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark m-0">Mediation & Arbitration Hub</h5>
                            <span class="text-muted small d-flex align-items-center gap-1">
                                <span class="bg-success rounded-circle d-inline-block" style="width:8px; height:8px;"></span>
                                Direct Secure Conduit Line (Admin &harr; Venue Owner)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Chat Dialog Area Content Stream Container -->
                <div class="card-body p-4 flex-grow-1 overflow-y-auto bg-light bg-opacity-30" id="chatStreamBox">
                    @if (!Model.Any())
                    {
                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-center text-muted opacity-70">
                            <i class="bi bi-chat-quote display-3 mb-2 text-success opacity-50"></i>
                            <h6 class="fw-bold text-dark">No Messages Exchanged Yet</h6>
                            <p class="small text-secondary px-4 mx-auto" style="max-width: 380px;">Initialize the resolution strategy pipeline logs by typing out the preliminary coordination context below.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var msg in Model)
                            {
                                bool isSelf = msg.SenderId == currentUserId;
                                string senderName = userDict.ContainsKey(msg.SenderId) ? userDict[msg.SenderId] : "System Node User";

                                <div class="d-flex flex-column @(isSelf ? "align-items-end" : "align-items-start")">
                                    <span class="text-xs text-muted mb-1 px-2 fw-medium" style="font-size: 0.775rem;">@senderName</span>
                                    
                                    <div class="p-3 px-4 rounded-4 shadow-sm" style="max-width: 75%; font-size: 0.925rem; word-break: break-word;
                                        @(isSelf ? "background-color: #198754; color: #ffffff; border-bottom-right-radius: 0px;"
                                                                                                                               : "background-color: #ffffff; color: #212529; border: 1px solid #e5e7eb; border-bottom-left-radius: 0px;")">
                                        @msg.MessageText
                                    </div>
                                    
                                    <span class="text-muted mt-1 font-monospace px-2" style="font-size: 0.7rem;">@msg.SentAt.ToLocalTime().ToString("t")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Footer Interactive Message Form Input Box -->
                <div class="card-footer bg-white border-top p-3 rounded-bottom-4">
                    <form asp-controller="ReportChat" asp-action="SendMessage" method="post" class="m-0 input-group gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reportId" value="@ticket?.Id" />
                        
                        <input type="text" name="messageText" autocomplete="off" required id="messageInputField"
                               class="form-control rounded-pill px-4 bg-light border-0 shadow-none py-2.5"
                               placeholder="Type administrative clarification summary or updates here..." />
                               
                        <button type="submit" class="btn btn-success rounded-pill px-4 d-flex align-items-center gap-2 shadow-sm fw-medium">
                            <span>Send</span> <i class="bi bi-send-fill small"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Smoothly lock viewport anchors down at the foot of the layout stream upon loading
        $(document).ready(function () {
            var box = document.getElementById("chatStreamBox");
            if (box) {
                box.scrollTop = box.scrollHeight;
            }
            $("#messageInputField").focus();
        });
    </script>
}