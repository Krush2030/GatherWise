@{
    ViewData["Title"] = "Welcome to GatherWise";
}

<div class="row align-items-center py-5 my-4">
    <div class="col-lg-6 text-center text-lg-start mb-4 mb-lg-0">
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-3 fw-semibold tracking-wide">
            <i class="bi bi-stars me-1"></i> Simplify Your Event Planning
        </span>
        <h1 class="display-3 fw-bold text-dark lh-1 mb-3">
            Discover & Book <br />
            <span class="text-success">Spectacular Venues</span>
        </h1>
        <p class="lead text-secondary mb-4" style="line-height: 1.7;">
            GatherWise orchestrates your entire event framework seamlessly. Reserve perfect local venues, schedule operational time slots, manage bookings, and handle digital invoices with ease.
        </p>
        <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
            <a asp-controller="Venue" asp-action="Index" class="btn btn-success btn-lg rounded-pill px-4 shadow-sm fw-semibold">
                <i class="bi bi-search me-1"></i> Explore Venues
            </a>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    List Your Property
                </a>
            }
        </div>
    </div>
    <div class="col-lg-6 text-center">
        <div class="p-5 bg-white shadow-sm rounded-4 border d-flex align-items-center justify-content-center position-relative overflow-hidden" style="min-height: 380px;">
            <div class="position-absolute top-0 end-0 m-3 opacity-10">
                <i class="bi bi-building-fill text-success" style="font-size: 15rem;"></i>
            </div>
            <div class="z-1">
                <i class="bi bi-calendar-check-fill text-success display-1 mb-3 d-block opacity-75"></i>
                <h3 class="fw-bold text-dark mb-1">Smart Slot Scheduling</h3>
                <p class="text-muted small mx-auto max-w-sm mb-0">Real-time availability mappings protected by exact relational constraints.</p>
            </div>
        </div>
    </div>
</div>

<hr class="my-5 opacity-25" />

<div class="row g-4 text-center justify-content-center mb-5">
    <div class="col-12 text-center mb-2">
        <h2 class="fw-bold text-dark">Engineered For Fluid Event Management</h2>
        <p class="text-muted">Explore the modular pipelines that drive your venue hosting operations.</p>
    </div>
    
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="card-body">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 d-inline-block mb-3 fs-3">
                    <i class="bi bi-building"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Venue Directory</h5>
                <p class="text-muted small mb-3">Upload up to 15 gallery image assets per property with automatic visual fallback grids.</p>
                <a asp-controller="Venue" asp-action="Index" class="text-success text-decoration-none small fw-semibold">
                    View Listings <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="card-body">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 d-inline-block mb-3 fs-3">
                    <i class="bi bi-calendar3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Time Allocations</h5>
                <p class="text-muted small mb-3">Define explicit availability parameters and assign custom pricing windows dynamically.</p>
                <a asp-controller="Slot" asp-action="Index" class="text-primary text-decoration-none small fw-semibold">
                    Manage Slots <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="card-body">
                <div class="p-3 bg-warning bg-opacity-10 text-warning-emphasis rounded-3 d-inline-block mb-3 fs-3">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Secure Ledger</h5>
                <p class="text-muted small mb-3">Built-in cascade protections and validation layers shield historical scheduling records.</p>
                <a asp-controller="Booking" asp-action="Index" class="text-warning-emphasis text-decoration-none small fw-semibold">
                    Track Orders <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-3 p-3 bg-white">
            <div class="card-body">
                <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 d-inline-block mb-3 fs-3">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Invoices & Receipts</h5>
                <p class="text-muted small mb-3">Generate complete invoices immediately upon checkout with instant on-demand local downloads.</p>
                <a asp-controller="Payment" asp-action="Index" class="text-danger text-decoration-none small fw-semibold">
                    Review Invoices <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>