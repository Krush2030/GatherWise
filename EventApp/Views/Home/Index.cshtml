@{
    ViewData["Title"] = "Welcome to GatherWise";
}

<!-- Custom Embedded Styles for Premium UI Touches (Keeps it cleanly packaged inside your Razor view) -->
<style>
    .hero-gradient {
        background: radial-gradient(circle at 85% 15%, rgba(25, 135, 84, 0.08) 0%, rgba(255, 255, 255, 0) 50%), radial-gradient(circle at 15% 85%, rgba(13, 110, 253, 0.05) 0%, rgba(255, 255, 255, 0) 50%);
    }

    .hover-lift {
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.075) !important;
        }

    .icon-box {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }
</style>

<div class="hero-gradient rounded-5 px-4 px-md-5 py-5 my-4 border border-light shadow-sm">
    <div class="row align-items-center py-4">
        <!-- Text Content -->
        <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 mb-4 fw-semibold tracking-wide border border-success border-opacity-10 animate__animated animate__fadeIn">
                <i class="bi bi-stars me-1 text-warning"></i> Simplify Your Event Planning
            </span>
            <h1 class="display-3 fw-extrabold text-dark tracking-tight lh-sm mb-3">
                Discover & Book <br />
                <span class="text-success bg-gradient">Spectacular Venues</span>
            </h1>
            <p class="lead text-secondary mb-4 fs-5 col-xl-11" style="line-height: 1.8;">
                GatherWise orchestrates your entire event framework seamlessly. Reserve perfect local venues, schedule operational time slots, manage bookings, and handle digital invoices with ease.
            </p>
            <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3 pt-2">
                <a asp-controller="Venue" asp-action="Index" class="btn btn-success btn-lg rounded-pill px-4 py-3 shadow-sm fw-semibold hover-lift d-inline-flex align-items-center">
                    <i class="bi bi-search me-2"></i> Explore Venues
                </a>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light border btn-lg rounded-pill px-4 py-3 fw-semibold text-secondary hover-lift d-inline-flex align-items-center">
                        <i class="bi bi-speedometer2 me-2"></i> Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light border btn-lg rounded-pill px-4 py-3 fw-semibold text-secondary hover-lift">
                        List Your Property
                    </a>
                }
            </div>
        </div>
        
        <!-- Interactive Visual Feature Block -->
        <div class="col-lg-6 px-xl-5">
            <div class="position-relative">
                <!-- Decorative background blob -->
                <div class="position-absolute top-50 start-50 translate-middle bg-success bg-opacity-10 rounded-circle filter-blur" style="width: 350px; height: 350px; filter: blur(50px); z-index: 0;"></div>
                
                <!-- The Core Modern Component Box -->
                <div class="glass-card shadow-lg rounded-4 p-5 text-center position-relative border border-white z-1 hover-lift">
                    <div class="icon-box bg-success bg-opacity-10 text-success mx-auto mb-4" style="width: 70px; height: 70px;">
                        <i class="bi bi-calendar-check-fill fs-2"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-2">Smart Slot Scheduling</h3>
                    <p class="text-secondary small mx-auto mb-0 px-md-4" style="line-height: 1.6;">
                        Real-time availability mappings protected by strict operational backend validation frameworks.
                    </p>
                    
                    <!-- Decorative subtle asset elements simulating an application view -->
                    <div class="mt-4 pt-3 border-top border-light d-flex justify-content-between text-start text-muted small">
                        <span><i class="bi bi-shield-check text-success me-1"></i> Auto-Release Window</span>
                        <span class="fw-semibold text-dark">60 Mins</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Section Headline -->
<div class="row pt-5 pb-3">
    <div class="col-12 text-center">
        <h2 class="fw-bold text-dark tracking-tight">Engineered For Fluid Event Management</h2>
        <p class="text-secondary col-md-6 mx-auto">Explore the modular pipelines that power your venue hosting operations day-to-day.</p>
    </div>
</div>
    
<!-- Grid Showcase -->
<div class="row g-4 mb-5">
    <!-- Venue Directory -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white hover-lift">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-success bg-opacity-10 text-success mb-3">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Venue Directory</h5>
                    <p class="text-secondary small mb-4" style="line-height: 1.6;">Upload up to 15 gallery image assets per property with automatic visual fallback grids.</p>
                </div>
                <a asp-controller="Venue" asp-action="Index" class="text-success text-decoration-none small fw-semibold icon-link icon-link-hover">
                    View Listings <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Time Allocations -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white hover-lift">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="bi bi-calendar3 fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Time Allocations</h5>
                    <p class="text-secondary small mb-4" style="line-height: 1.6;">Define explicit availability parameters and assign custom pricing windows dynamically.</p>
                </div>
                <a asp-controller="Slot" asp-action="Index" class="text-primary text-decoration-none small fw-semibold icon-link icon-link-hover">
                    Manage Slots <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Secure Ledger -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white hover-lift">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning-emphasis mb-3">
                        <i class="bi bi-journal-bookmark-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Secure Ledger</h5>
                    <p class="text-secondary small mb-4" style="line-height: 1.6;">Built-in cascade protections and validation layers shield historical scheduling records.</p>
                </div>
                <a asp-controller="Booking" asp-action="Index" class="text-warning-emphasis text-decoration-none small fw-semibold icon-link icon-link-hover">
                    Track Orders <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Invoices & Receipts -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white hover-lift">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger mb-3">
                        <i class="bi bi-receipt-cutoff fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Invoices & Receipts</h5>
                    <p class="text-secondary small mb-4" style="line-height: 1.6;">Generate complete invoices immediately upon checkout with instant on-demand downloads.</p>
                </div>
                <a asp-controller="Payment" asp-action="Index" class="text-danger text-decoration-none small fw-semibold icon-link icon-link-hover">
                    Review Invoices <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>