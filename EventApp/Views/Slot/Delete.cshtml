@model GatherWise.Domain.Entities.Slot

@{
    ViewData["Title"] = "Remove Slot";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <!-- High-visibility Danger Alert Header -->
                <div class="bg-danger bg-opacity-10 text-danger p-4 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-danger text-white rounded-3 fs-4 d-inline-flex shadow-sm">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold text-dark">Remove Availability Slot?</h4>
                            <p class="text-muted mb-0 small">This will retract the time block from customer options.</p>
                        </div>
                    </div>
                </div>

                <!-- Structured Metadata Box Body -->
                <div class="card-body p-4 text-center">
                    <div class="mb-3 mt-2 text-danger opacity-20">
                        <i class="bi bi-calendar-x" style="font-size: 4rem;"></i>
                    </div>
                    
                    <h4 class="text-dark fw-bold mb-1">@Model.Venue?.Name</h4>
                    <p class="text-muted small mb-4"><i class="bi bi-geo-alt me-1"></i> @(Model.Venue?.Location ?? "Managed Location")</p>

                    <!-- Focused Parameters Summary Display -->
                    <div class="bg-light border rounded-3 p-3 text-start mb-4">
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-2 border-white">
                            <span class="text-secondary small fw-medium">Scheduled Date:</span>
                            <span class="text-dark fw-semibold small"><i class="bi bi-calendar-event me-1"></i> @Model.Date.ToString("dd MMM, yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary small fw-medium">Time Window:</span>
                            <span class="text-dark font-monospace small"><i class="bi bi-clock me-1"></i> @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</span>
                        </div>
                    </div>

                    <!-- Interface Form Submissions Wrapper -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 justify-content-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel, Keep Open</a>
                            <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm fw-semibold">Confirm Removal</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>