@model IEnumerable<GatherWise.Domain.Entities.Slot>
@using System.Security.Claims

@{
    ViewData["Title"] = "Manage Time Slots";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container my-4">
    <!-- Header Block -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 mb-2 fw-semibold">
                <i class="bi bi-calendar3 me-1"></i> Allocation Engine
            </span>
            <h1 class="h2 fw-bold text-dark mb-1">Venue Availability Slots</h1>
            <p class="text-muted small mb-0">Allocate, manage, and audit operational timelines across your registered properties.</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Venue Owner"))
        {
            <div>
                <a class="btn btn-success rounded-pill px-4 shadow-sm fw-medium d-flex align-items-center gap-2" asp-action="Create">
                    <i class="bi bi-calendar-plus-fill"></i> Create Availability Slot
                </a>
            </div>
        }
    </div>

    <!-- Empty State Fallback -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light">
            <div class="p-4 bg-light text-warning rounded-circle d-inline-block mb-3">
                <i class="bi bi-calendar-x display-4"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Operational Slots Scheduled</h4>
            <p class="text-muted small mx-auto mb-4" style="max-w-md: 400px;">
                There are no active time entries available. Generate new layout windows so hosts can begin registering structural customer bookings.
            </p>
            @if (User.IsInRole("Admin") || User.IsInRole("Venue Owner"))
            {
                <a class="btn btn-outline-success rounded-pill px-4 btn-sm" asp-action="Create">
                    Configure First Entry
                </a>
            }
        </div>
    }
    else
    {
        <!-- Modern Table Wrapper Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase tracking-wider text-secondary small fw-bold">Venue Properties</th>
                            <th class="py-3 text-uppercase tracking-wider text-secondary small fw-bold">Target Date</th>
                            <th class="py-3 text-uppercase tracking-wider text-secondary small fw-bold">Time Window</th>
                            <th class="py-3 text-uppercase tracking-wider text-secondary small fw-bold">Status</th>
                            <th class="text-end pe-4 py-3 text-uppercase tracking-wider text-secondary small fw-bold">Management</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in Model)
                        {
                            <tr>
                                <!-- Venue Name with icon link placeholder -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 small">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@slot.Venue?.Name</span>
                                            <span class="text-muted extreme-small text-lowercase" style="font-size: 0.75rem;">
                                                <i class="bi bi-geo-alt"></i> @(slot.Venue?.Location ?? "Managed Property")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                
                                <!-- Formatted target date -->
                                <td class="py-3 text-secondary fw-medium">
                                    <i class="bi bi-calendar-event me-1 text-muted"></i>
                                    @slot.Date.ToString("dd MMM, yyyy")
                                </td>
                                
                                <!-- Operational Time Boundaries -->
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1.5 font-monospace small fw-normal">
                                        <i class="bi bi-clock text-secondary me-1"></i>
                                        @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                                    </span>
                                </td>
                                
                                <!-- Contextual badges mirroring reservation status -->
                                <td class="py-3">
                                    @if (slot.IsBooked)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                                            <span class="p-1 bg-danger rounded-circle d-inline-block animate-pulse" style="width:6px; height:6px;"></span>
                                            Reserved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1">
                                            <span class="p-1 bg-success rounded-circle d-inline-block" style="width:6px; height:6px;"></span>
                                            Available
                                        </span>
                                    }
                                </td>
                                
                                <!-- Row Actions based on data ownership parameters -->
                                <td class="text-end pe-4 py-3">
                                    @if (User.IsInRole("Admin") || slot.Venue?.OwnerId == currentUserId)
                                    {
                                        <a asp-action="Delete" asp-route-id="@slot.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-medium transition-all">
                                            <i class="bi bi-trash3 small me-1"></i> Remove
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border border-light rounded-pill px-3 py-1.5 fs-7 fw-normal">
                                            <i class="bi bi-lock-fill me-1"></i> View Only
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>